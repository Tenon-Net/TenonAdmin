<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Open-source repo pins to nuget.org only: clear machine-level private sources so anyone can restore right after clone -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
