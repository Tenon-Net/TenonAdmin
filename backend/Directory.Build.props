<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- 发布包携带 XML 注释(项目注释详尽,是包价值的一部分);CS1591 不强制每个 public 都写注释 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- ── NuGet 包元数据(T10;所有包共享)。默认不打包,src 各包显式开 IsPackable ── -->
    <IsPackable>false</IsPackable>
    <Version>0.1.1</Version>
    <Authors>huguodong</Authors>
    <Company>Tenon-Net</Company>
    <Product>TenonAdmin</Product>
    <Copyright>Copyright © Tenon-Net</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Tenon-Net/TenonAdmin</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Tenon-Net/TenonAdmin</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>tenon-icon.png</PackageIcon>
    <PackageTags>admin;rbac;sqlsugar;aspnetcore;scaffold;kernel</PackageTags>
    <!-- 指向 CHANGELOG,不在这里写死某个版本的说明:版本号由 tag 经 -p:Version 覆盖,而这段文字不会 ——
         写死就意味着发 0.2.0 时包说明页上仍挂着 0.0.1-preview 的内容,且没有任何东西会提醒你。 -->
    <PackageReleaseNotes>更新日志:https://github.com/Tenon-Net/TenonAdmin/blob/main/CHANGELOG.md</PackageReleaseNotes>

    <!-- ── 可调试性:内核是给人继承和重写的,消费者步不进源码就没法判断该重写哪一步 ──
         SourceLink 由 .NET SDK 内置(不引第三方包);符号走 snupkg,与 nupkg 同名一并推送。
         ContinuousIntegrationBuild 只在 CI 开:它把源码路径规范化,本地开着会打乱调试路径。 -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- 每个打包项目都带仓库根 README 作包说明页 + 包图标;非打包项目此 None 为空操作。
       图标源是 web/design-mockups/brand/tenon-logo.svg —— NuGet 只认 png/jpg,故这里放光栅化后的副本。 -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)tenon-icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
