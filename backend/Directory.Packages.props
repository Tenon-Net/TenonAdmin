<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="SqlSugarCore" Version="5.1.4.198" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <!-- 显式抬到 3.0.3:MDS 传递的 2.1.10/2.1.11 命中 SQLite CVE(NU1903 GHSA-2m69-gcr7-jv3q),3.0.x 已修补 -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <!-- 显式抬版:AspNetCore.OpenApi 10.0.9 传递的 Microsoft.OpenApi 2.0.0 命中高危 CVE(NU1903 GHSA-v5pm-xwqc-g5wc,漏洞范围 2.0.0-preview.11~2.7.4),2.7.5 起修补 -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.0" />
    <!-- DI/Logging 抽象抬到 10.0.5:StackExchange.Redis 3.0.11 传递依赖 Logging.Abstractions 10.0.5(要求 DI.Abstractions ≥10.0.5),
         与集中版本 10.0.0 冲突会报 NU1605 降级;补丁级上抬对既有项目安全 -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
    <!-- 仅 TenonAdmin.Caching.Redis 可选包直接引用(RedisCacheProvider);核心四包不引,保持"运行时只依赖 SqlSugarCore + Microsoft.*" -->
    <PackageVersion Include="StackExchange.Redis" Version="3.0.11" />
    <!-- 仅 TenonAdmin.Excel 卫星包直接引用:MiniExcel 读写 xlsx;DocumentFormat.OpenXml 只生成带 dataValidation 的模板。核心四包不引 -->
    <PackageVersion Include="MiniExcel" Version="1.45.0" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- 可选包读取 TenonAdmin:Cache 配置节自装配用(RedisSetup);同属 Microsoft.* -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <!-- 仅 samples/WorkerHost 用(纯 Generic Host,没有 ASP.NET 共享框架可蹭);内核包一律只依赖 Abstractions -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <!-- 测试(T9):xUnit + WebApplicationFactory -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <!-- MySQL 测试驱动(仅测试项目直接引用,用于建/删测试库);版本对齐 SqlSugarCore 5.1.4 传递的 2.2.5,不引入版本漂移。
         核心四包不直接引用它(保持"运行时只依赖 SqlSugarCore + Microsoft.*";MySql 驱动本就随 SqlSugarCore 传递可用) -->
    <PackageVersion Include="MySqlConnector" Version="2.2.5" />
    <!-- SQL Server 测试驱动(仅测试项目直接引用,用于建/删测试库);版本对齐 SqlSugarCore 5.1.4 传递的 5.2.2,不引入版本漂移。
         它是 Microsoft.*,不违反核心"运行时只依赖 SqlSugarCore + Microsoft.*";SqlServer 驱动本就随 SqlSugarCore 传递可用 -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <!-- PostgreSQL 测试驱动(仅测试项目直接引用,用于建/删测试库);版本对齐 SqlSugarCore 5.1.4 传递的 5.0.18,不引入版本漂移。
         核心四包不直接引用它(保持"运行时只依赖 SqlSugarCore + Microsoft.*";PostgreSQL 驱动本就随 SqlSugarCore 传递可用) -->
    <PackageVersion Include="Npgsql" Version="5.0.18" />
  </ItemGroup>
</Project>
