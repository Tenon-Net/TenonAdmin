{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "TenonAdmin": {
    // 实时通知(SignalR):与 MinimalHost 一致开启,双前端的公告角标与强退即时生效
    "Realtime": {
      "Enabled": true
    },
    "Integration": {
      "Outbound": {
        "Targets": {
          // 合作方系统。本地演示指向 IntegrationMockPartner(dotnet run --project backend/samples/IntegrationMockPartner)。
          // 内部地址必须显式列入 TrustedCidrs 才放行;秘密不写在这里,见 appsettings.Development.json.example。
          "partner": {
            "BaseUrl": "http://127.0.0.1:5300/api/",
            "TimeoutSeconds": 10,
            "TrustedCidrs": [ "127.0.0.1/32" ],
            "Auth": { "Type": "Bearer" }
          }
        }
      }
    }
  }
}
