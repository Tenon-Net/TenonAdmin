{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "TenonAdmin": {
    "Logging": {
      // 文件日志:默认关(靠 stdout 采集)。开了才写 logs/{级别}/{yyyyMMdd}.log
      // 级别过滤走上面标准的 Logging:File:LogLevel:*(provider 别名 File),不在这里配
      "File": {
        "Enabled": false,
        "Path": "logs",
        "RetainDays": 14,
        "MaxFileSizeMb": 100
      }
    }
  }
}
