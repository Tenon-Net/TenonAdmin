{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "TenonAdmin": {
    "Database": {
      // 必须与 API 副本连同一个库,且必须是服务器数据库——SQLite 不支持集群形态(scheduling-ledger §10.4)
      "DbType": "MySql",
      "ConnectionString": "Server=127.0.0.1;Port=3306;Database=tenon;User ID=root;Password=root;",
      // schema 归 API 侧所有:Worker 不建表、不播种,免得两个进程同时 DDL
      "EnableCodeFirst": false,
      "EnableSeed": false
    },
    "Cache": {
      // 与 API 共享缓存是多进程部署的前提(强退、权限缓存、限流计数都在这上面)
      "Provider": "Redis",
      "Redis": "127.0.0.1:6379"
    },
    "Id": {
      // 必填且必须与所有 API 副本、其它 Worker 互不相同(0–63);不配直接抛
      "WorkerId": 10
    },
    "Jobs": {
      "SchedulerEnabled": true
    }
  }
}
