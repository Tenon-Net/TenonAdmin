<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>TenonAdmin 宿主接入层:AddTenonAdmin / MapTenonAdmin 一键装配、JWT 认证、[RolePermission] 授权、内置控制器与过滤器。</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TenonAdmin.Services\TenonAdmin.Services.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- JWT 认证(设计 §2.2 替代表:替换 MoYu.Extras JWT,用微软官方件) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- 内置 OpenAPI 文档生成(设计 §12/§13.6:产出 openapi.json 作前端契约源) -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- 直接引用抬到修补版,压过 AspNetCore.OpenApi 传递来的 2.0.0(消 NU1903 高危) -->
    <PackageReference Include="Microsoft.OpenApi" />
  </ItemGroup>
</Project>
