<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- 单元测试里用到 ObjectResult 等 MVC 类型,需 ASP.NET 共享框架 -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TenonAdmin.AspNetCore\TenonAdmin.AspNetCore.csproj" />
    <ProjectReference Include="..\TenonAdmin.TestHost\TenonAdmin.TestHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- MySQL 矩阵腿的驱动;SQLite 默认腿不用它,但引用无害(SqlSugar 按 DbType 选驱动) -->
    <PackageReference Include="MySqlConnector" />
    <!-- SQL Server 矩阵腿的驱动;默认腿不用它,但引用无害(SqlSugar 按 DbType 选驱动) -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>
</Project>
