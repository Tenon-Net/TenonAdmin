{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // TenonAdmin 全部配置都在这一节下,不写即用默认值(默认值就是「零配置可跑」的那套)。
  // 下面注释掉的是上生产前最该过一遍的几项;完整清单见 docs/deployment.md。
  "TenonAdmin": {
    // 签名密钥。留空 = 开发密钥模式(自动生成并落到 ./data/dev-jwt.key,同时打印警告)。
    // 生产必须显式配置 ≥32 字节随机串,且别提交进版本库(用环境变量 TenonAdmin__Jwt__SecretKey)。
    // "Jwt": { "SecretKey": "" },

    // 跨源:默认空 = 不放行任何跨源。前端与后端同源(nginx 反代 / 后端托管 dist)时无需配置。
    // "Api": { "Cors": { "AllowedOrigins": [ "https://admin.example.com" ] } },

    // 上传目录。若打算用 app.UseStaticFiles() 托管前端产物,必须把它挪出 wwwroot,
    // 否则上传的文件会被静态中间件匿名直出,绕过鉴权下载接口(见 docs/deployment.md)。
    // "Upload": { "RootPath": "./storage/upload" },

    // 同机不配时文件锁自动错开;跨机器/容器每个实例的 WorkerId(0–63)必须不同,否则同毫秒发号会撞主键。
    // "Id": { "WorkerId": 0 },

//#if (integration)
    // 第三方接入。出站目标按名字配置,Integrations/ 下的示例都用名为 partner 的目标。
    // 示例指向内核仓库里的本地可控第三方(dotnet run --project backend/samples/IntegrationMockPartner,监听 127.0.0.1:5300);
    // 对接真实系统时改 BaseUrl,并按对方协议改 Integrations/ 下的示例方法。
    // 内网地址(含 127.0.0.1)必须列入 TrustedCidrs 才放行。秘密不写在这里:
    // 用环境变量 TenonAdmin__Integration__Outbound__Targets__partner__Secret 或 dotnet user-secrets 提供。
    "Integration": {
      "Outbound": {
        "Targets": {
          "partner": {
            "BaseUrl": "http://127.0.0.1:5300/api/",
            "TimeoutSeconds": 10,
            "TrustedCidrs": [ "127.0.0.1/32" ],
            "Auth": { "Type": "Bearer" }
          }
        }
      }
    },

//#endif
    // 默认 SQLite,首启自动建表 + 写种子,并在控制台打印一次随机超管密码。
    // 换库:DbType = Sqlite | MySql | SqlServer | PostgreSQL
    "Database": {
      "DbType": "Sqlite",
      "ConnectionString": "Data Source=./data/admin.db"
    }
  }
}
