    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.6.6",
    "react-router-dom": "^7.18.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@iconify-json/ant-design": "^1.2.8",
    "@iconify-json/ep": "^1.2.4",
    "@iconify-json/lucide": "^1.2.118",
