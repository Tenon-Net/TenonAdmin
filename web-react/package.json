{
  "name": "tenon-admin-web-react",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@redocly/openapi-core": {
      "js-yaml": "4.3.2"
    }
  },
  "scripts": {
    "predev": "npm run gen:icons",
    "dev": "vite",
    "prebuild": "npm run gen:icons",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:integration": "playwright test -c playwright.integration.config.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "gen:api": "node scripts/gen-api.mjs",
    "gen:icons": "node scripts/generate-icon-subset.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/pro-components": "^3.1.14-7",
    "@iconify/react": "^6.0.2",
    "@microsoft/signalr": "^10.0.11",
    "antd": "^6.6.5",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "highlight.js": "^11.12.0",
    "i18next": "^25.10.10",
    "md-editor-rt": "^6.5.6",
    "openapi-fetch": "^0.13.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^16.6.6",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@iconify-json/ant-design": "^1.2.9",
    "@iconify-json/ep": "^1.2.4",
    "@iconify-json/lucide": "^1.2.137",
    "@iconify-json/ph": "^1.2.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "openapi-typescript": "^7.6.1",
    "oxlint": "1.74.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
