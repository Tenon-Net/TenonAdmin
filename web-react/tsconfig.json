{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    // **不要在这里加 "node"**。它是项目级的:加上之后 `process.env`、`__dirname` 这类东西在
    // **浏览器源码**里也能静默通过 typecheck,而运行时是 undefined。`web/` 那边没有这一条,
    // 同一行代码搬过去就会红 —— 两个模板的判据必须一样紧。
    // 个别确实要读文件的 spec(如主题桥比对 tokens.css)在**该文件顶部**写
    // `/// <reference types="node" />`,把豁免限制在一个文件内。
    "types": ["vite/client"],
    "baseUrl": ".",
    // 自包含:只有 `@/*`。既没有 `@shared/*`,也不需要给裸包指路 —— 依赖都在自己的 node_modules 里。
    "paths": { "@/*": ["src/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "env.d.ts"]
}
