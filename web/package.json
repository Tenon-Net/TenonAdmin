{
  "name": "tenon-admin-web",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:integration": "playwright test -c playwright.integration.config.ts",
    "gen:api": "node scripts/gen-api.mjs"
  },
  "dependencies": {
    "@iconify/vue": "^4.3.0",
    "@microsoft/signalr": "^10.0.11",
    "@vueuse/core": "^14.4.0",
    "echarts": "^6.1.0",
    "highlight.js": "^11.12.0",
    "md-editor-v3": "^6.5.6",
    "naive-ui": "^2.45.3",
    "openapi-fetch": "^0.13.5",
    "pinia": "^3.0.1",
    "pinia-plugin-persistedstate": "^4.2.0",
    "tenon-naive-iconify-picker": "^0.1.3",
    "tenon-naive-pro-table": "^0.3.1",
    "vue": "^3.5.43",
    "vue-echarts": "^8.3.0",
    "vue-i18n": "^11.4.12",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@iconify-json/ant-design": "^1.2.9",
    "@iconify-json/ep": "^1.2.4",
    "@iconify-json/ph": "^1.2.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "happy-dom": "^20.14.5",
    "openapi-typescript": "^7.6.1",
    "oxlint": "^1.85.0",
    "typescript": "^5.7.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "@redocly/openapi-core": {
      "js-yaml": "4.3.2"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
